# Firebase project config — copy this file to .env and fill in real values.
# Get these from Firebase Console > Project settings > General > Your apps > SDK setup.
#
# Keep this file's values EMPTY: it is committed to git. Real values belong in .env,
# which is gitignored.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
